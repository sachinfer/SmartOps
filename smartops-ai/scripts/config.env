# Configuration file for Helm Charts Updater
# Copy this file to your helm-charts repository and customize as needed

# Repository Configuration
HELM_CHARTS_REPO=https://github.com/sachinfer/helm-charts.git
HELM_CHARTS_PATH=smartops

# Git Configuration
GIT_USER=SmartOps Bot
GIT_EMAIL=bot@smartops.ai

# Image Tag Configuration
IMAGE_TAG_PREFIX=v1.0
IMAGE_TAG_FORMAT=yyyyMMdd-HHmmss

# Applications to Update
APPS=smartops-anomaly,smartops-dashboard,smartops-monitor

# ArgoCD Configuration
ARGOCD_NAMESPACE=argocd
ARGOCD_PROJECT=default

# Notification Settings (optional)
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
EMAIL_NOTIFICATIONS=false
